{
  "name": "usps-address-validation-express",
  "version": "1.0.0",
  "description": "USPS Address Validation Service - Express.js Backend",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc && cp -r src/public dist/public",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "test": "jest --run",
    "test:unit": "jest --testPathPattern=tests/unit --run",
    "test:integration": "jest --testPathPattern=tests/integration --run",
    "test:property": "jest --testPathPattern=tests/property --run"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.1",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  }
}
